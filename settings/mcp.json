{
	"servers": {
		"heroui-pro": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${input:HEROUI_PERSONAL_TOKEN}"
			},
			"tools": ["*"]
		}
	},
	"inputs": [
		{
			"type": "command",
			"id": "HEROUI_PERSONAL_TOKEN",
			"command": "op",
			"args": [
				"run",
				"--environment=hgr3tuvkjzcpxmg5vp4mdepgju",
				"--no-masking",
				"--",
				"printenv HEROUI_PERSONAL_TOKEN"
			]
		}
	]
}
