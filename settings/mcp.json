{
	"servers": {
		"Astro Docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"Chrome DevTools": {
			"type": "stdio",
			"command": "pnpx",
			"args": ["chrome-devtools-mcp@latest"]
		},
		"Cloudflare": {
			"type": "http",
			"url": "https://mcp.cloudflare.com/mcp"
		},
		"Cloudflare AI Gateway": {
			"type": "http",
			"url": "https://ai-gateway.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Audit Logs": {
			"type": "http",
			"url": "https://auditlogs.mcp.cloudflare.com/mcp"
		},
		"Cloudflare AutoRAG": {
			"type": "http",
			"url": "https://autorag.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Blog": {
			"type": "http",
			"url": "https://blog.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Browser Run": {
			"type": "http",
			"url": "https://browser.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Container": {
			"type": "http",
			"url": "https://containers.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Demo Day": {
			"type": "http",
			"url": "https://demo-day.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Digital Experience Monitoring": {
			"type": "http",
			"url": "https://dex.mcp.cloudflare.com/mcp"
		},
		"Cloudflare DNS Analytics": {
			"type": "http",
			"url": "https://dns-analytics.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Documentation": {
			"type": "http",
			"url": "https://docs.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Logpush": {
			"type": "http",
			"url": "https://logs.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Observability": {
			"type": "http",
			"url": "https://observability.mcp.cloudflare.com/mcp"
		},
		"Cloudflare One CASB": {
			"type": "http",
			"url": "https://casb.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Radar": {
			"type": "http",
			"url": "https://radar.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Workers Bindings": {
			"type": "http",
			"url": "https://bindings.mcp.cloudflare.com/mcp"
		},
		"Cloudflare Workers Builds": {
			"type": "http",
			"url": "https://builds.mcp.cloudflare.com/mcp"
		},
		"Figma": {
			"type": "http",
			"url": "https://mcp.figma.com/mcp"
		},
		"Firecrawl": {
			"type": "http",
			"url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
		},
		"GitHub": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"HeroUI React": {
			"type": "stdio",
			"command": "pnx",
			"args": ["@heroui/react-mcp@latest"]
		},
		"HeroUI Pro React": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${input:HEROUI_PERSONAL_TOKEN}"
			}
		},
		"MDN": {
			"type": "http",
			"url": "https://mcp.mdn.mozilla.net/"
		},
		"Next.js DevTools": {
			"type": "stdio",
			"command": "pnx",
			"args": ["next-devtools-mcp@latest"]
		},
		"React Aria": {
			"command": "pnpx",
			"args": ["@react-aria/mcp@latest"]
		},
		"Sentry": {
			"type": "stdio",
			"command": "pnx",
			"args": ["@sentry/mcp-server@latest"],
			"env": {
				"SENTRY_ACCESS_TOKEN": "${input:SENTRY_ACCESS_TOKEN}"
			}
		},
		"Supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp"
		}
	},
	"inputs": [
		{
			"id": "HEROUI_PERSONAL_TOKEN",
			"type": "promptString",
			"description": "Enter your HeroUI Pro Personal Token",
			"password": true
		},
		{
			"id": "SENTRY_ACCESS_TOKEN",
			"type": "promptString",
			"description": "Enter your Sentry personal token",
			"password": true
		}
	]
}
