{
	"servers": {
		"HeroUI Pro React": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${input:HEROUI_PERSONAL_TOKEN}"
			}
		},
		"HeroUI React": {
			"type": "stdio",
			"command": "pnx",
			"args": ["@heroui/react-mcp@latest"]
		},
		"Astro Docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"Figma": {
			"type": "http",
			"url": "https://mcp.figma.com/mcp"
		},
		"Supabase": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp"
		},
		"Firecrawl": {
			"type": "http",
			"url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
		},
		"GitHub": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"Chrome DevTools": {
			"type": "stdio",
			"command": "pnpx",
			"args": ["chrome-devtools-mcp@latest"]
		},
		"Sentry": {
			"type": "stdio",
			"command": "pnx",
			"args": ["@sentry/mcp-server@latest"],
			"env": {
				"SENTRY_ACCESS_TOKEN": "${input:SENTRY_ACCESS_TOKEN}"
			}
		},
		"Next.js DevTools": {
			"type": "stdio",
			"command": "pnx",
			"args": ["next-devtools-mcp@latest"]
		},
		"MDN": {
			"type": "http",
			"url": "https://mcp.mdn.mozilla.net/"
		}
	},
	"inputs": [
		{
			"id": "HEROUI_PERSONAL_TOKEN",
			"type": "promptString",
			"description": "Your HeroUI Personal Token",
			"password": true
		},
		{
			"id": "SENTRY_ACCESS_TOKEN",
			"type": "promptString",
			"description": "Your Sentry user authentication token",
			"password": true
		}
	]
}
