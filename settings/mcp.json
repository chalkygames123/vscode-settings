{
	"servers": {
		"heroui-pro": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${input:HEROUI_PERSONAL_TOKEN}"
			},
			"tools": ["*"]
		}
	},
	"inputs": [
		{
			"type": "command",
			"id": "HEROUI_PERSONAL_TOKEN",
			"command": "op",
			"args": ["run", "--env-file=\"$HOME/.copilot/.env\"", "--", "sh", "-c", "'echo \"$HEROUI_PERSONAL_TOKEN\"'"]
		}
	]
}
