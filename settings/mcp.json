{
	"servers": {
		"Astro Docs": {
			"type": "http",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"Cloudflare": {
			"type": "http",
			"url": "https://mcp.cloudflare.com/mcp"
		},
		"Figma": {
			"type": "http",
			"url": "https://mcp.figma.com/mcp"
		},
		"GitHub": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp"
		},
		"HeroUI Pro React": {
			"type": "http",
			"url": "https://mcp.heroui.pro/mcp",
			"headers": {
				"x-heroui-personal-token": "${input:HEROUI_PRO_PERSONAL_TOKEN}"
			}
		},
		"MDN": {
			"type": "http",
			"url": "https://mcp.mdn.mozilla.net/"
		},
		"React Aria": {
			"command": "pnx",
			"args": ["@react-aria/mcp@latest"]
		},
		"Sentry": {
			"type": "http",
			"url": "https://mcp.sentry.dev/mcp"
		},
		"Supabase (local)": {
			"type": "http",
			"url": "http://localhost:54321/mcp"
		},
		"Supabase (remote)": {
			"type": "http",
			"url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
		}
	},
	"inputs": [
		{
			"type": "promptString",
			"id": "HEROUI_PRO_PERSONAL_TOKEN",
			"description": "HeroUI Pro Personal Token",
			"password": true
		}
	]
}
